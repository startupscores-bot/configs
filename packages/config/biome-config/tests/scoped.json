{
	"$schema": "../../../../node_modules/@biomejs/biome/configuration_schema.json",
	"linter": {
		"rules": {
			"recommended": false
		}
	},
	"plugins": [
		{
			"path": "../plugins/scoped/no-adapter-import.grit",
			"includes": [
				"**/scoped-*.ts"
			]
		},
		{
			"path": "../plugins/scoped/no-direct-response.grit",
			"includes": [
				"**/response-*.ts"
			]
		}
	]
}
